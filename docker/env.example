# Self-host environment — copy to .env.selfhost and fill values
# Generated by scripts/setup-selfhost.sh

# Base URL where the web app is reachable (browser -> web)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
CONVEX_URL=http://convex:3210

# Personal / local mode (self-host is always personal/local)
PERSONAL_MODE=true
NEXT_PUBLIC_PERSONAL_MODE=true
PERSONAL_IN_PROCESS_AGENT=true
NEXT_PUBLIC_PERSONAL_IN_PROCESS_AGENT=true
DISABLE_E2B=true
NEXT_PUBLIC_DISABLE_E2B=true

# OpenCode Zen (optional — set your key for free models)
OPENCODE_ZEN_ENABLED=true
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=nemotron-3-ultra-free
OPENCODE_ZEN_MODEL_STANDARD=nemotron-3-ultra-free
OPENCODE_ZEN_MODEL_PRO=nemotron-3-ultra-free
OPENCODE_ZEN_MODEL_MAX=hy3-free
OPENCODE_ZEN_MODEL_VISION=mimo-v2.5-free

# Centrifugo — generated by setup script (32+ random chars)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=
CENTRIFUGO_API_KEY=
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket

# Convex (local)
# For --mode cloud, set CONVEX_URL to your Convex Cloud deployment instead
CONVEX_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210

# Personal JWT (generated by setup script)
PERSONAL_JWT_ISSUER=http://localhost:3000
PERSONAL_JWT_AUDIENCE=hackerai-personal
PERSONAL_JWT_PRIVATE_KEY_PATH=.personal/jwt-private.pem
PERSONAL_JWT_PUBLIC_KEY_PATH=.personal/jwt-public.pem

# Kiro (optional — via the local Kiro Gateway, an OpenAI-compatible proxy)
# Start the gateway with ./start.sh, then set its PROXY_API_KEY here.
# KIRO_GATEWAY_API_KEY=
# KIRO_GATEWAY_BASE_URL=http://127.0.0.1:8002/v1

# Storage
LOCAL_STORAGE_DIR=/app/.local-storage

# Razorpay (optional — for redeem/payment in self-host, not required)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
