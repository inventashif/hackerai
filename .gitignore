# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# e2e tests
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/test-files/
/e2e/.auth/
.env.e2e
.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# Local runtime state and user uploads
#
# `.local-storage` contains real user files and may include private bug-bounty
# program data, customer information, findings, and PoCs. It must never enter
# Git history — deleting it in a later commit would not remove it from clones,
# forks, caches, or GitHub's event stream.
/.local-storage/
/.convex/
/.swc/
/data/
/logs/
/output/
/cache/
/debug_logs/

# Local security-research workspaces. These may contain private-program scope,
# confirmed findings, PoCs, customer data, and NDA material. Keep them outside
# source control even when this repository itself is private: Git history is
# durable and can later be mirrored, forked, or accidentally made public.
/findings-*/
/*_analysis/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright auth states
.auth/
CLAUDE.md
packages/local/node_modules/

# Desktop (Tauri)
packages/desktop/node_modules/
packages/desktop/src-tauri/target/

.personal/
public/.well-known/jwks.json

.trigger
